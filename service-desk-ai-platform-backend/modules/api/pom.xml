    <dependencies>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>knowledge-loader</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>pinecone-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>servicenow-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>llm-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>analytics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.servicedesk.ai</groupId>
            <artifactId>infrastructure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
