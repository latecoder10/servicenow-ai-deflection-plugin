# ══════════════════════════════════════════════════════════════
# ServiceNow AI Service Desk - Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values
# ══════════════════════════════════════════════════════════════

# ──────────────────────── AI / LLM ────────────────────────
GEMINI_API_KEY=

# ──────────────────────── PINECONE ────────────────────────
AI_PINECONE_API_KEY=
AI_PINECONE_HOST=

# ──────────────────────── POSTGRESQL ────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/servicedesk_ai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

# ──────────────────────── SERVICENOW ────────────────────────
SERVICENOW_INSTANCE_URL=https://dev440425.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# ──────────────────────── SCHEDULER ────────────────────────
# SCHEDULER_SERVICENOW_ENABLED=true
# SCHEDULER_SERVICENOW_CRON=0 0 2 * * ?
# SCHEDULER_SERVICENOW_SYNC_LIMIT=500
# SCHEDULER_SERVICENOW_LOOKBACK_SECONDS=86400

# ──────────────────────── SERVER ────────────────────────
# SERVER_PORT=8080

# ──────────────────────── GOOGLE DRIVE ────────────────────────
# See docs/GOOGLE-DRIVE-SYNC.md for the service account setup.
GDRIVE_ENABLED=false
GDRIVE_CREDENTIALS_PATH=./secrets/gdrive-key.json
GDRIVE_FOLDER_ID=
# GDRIVE_DRIVE_ID=            # shared drive only
SCHEDULER_GDRIVE_ENABLED=false
# SCHEDULER_GDRIVE_CRON=0 30 2 * * ?
