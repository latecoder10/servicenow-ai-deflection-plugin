    {
      "name": "Google Drive Knowledge Sync",
      "description": "Indexes .docx and Google Docs from a shared Drive folder.\n\nSetup: a Google Cloud service account with the Drive API enabled, its JSON key at gdrive.credentials-path, and the target folder shared with the account's client_email as Viewer.\n\nSync is incremental by modification time. Each run advances a watermark stored on the connector_configurations row, so only changed documents are re-indexed.",
      "item": [
        {
          "name": "Test Google Drive Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/connectors/GOOGLE_DRIVE/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "connectors",
                "GOOGLE_DRIVE",
                "test"
              ]
            },
            "description": "Verifies the service account key signs, the token exchange succeeds, and the configured folder is readable. Returns false if gdrive.enabled is off.",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('connector is CONNECTED', () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.status, b.message).to.eql('CONNECTED');",
                  "});",
                  "",
                  "// DISCONNECTED here means one of: gdrive.enabled is false, the key path is",
                  "// wrong, the Drive API is not enabled on the project, or the folder was not",
                  "// shared with the service account's client_email."
                ]
              }
            }
          ]
        },
        {
          "name": "Full Sync (index every document)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/connectors/GOOGLE_DRIVE/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "connectors",
                "GOOGLE_DRIVE",
                "sync"
              ]
            },
            "description": "Ignores the stored watermark and re-indexes every document in the folder.\n\nThe connector type comes from the URL path; syncType, workspace and batchLimit come from the body (SyncRequest).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"syncType\": \"FULL\",\n  \"workspace\": \"Enterprise IT\",\n  \"batchLimit\": 500\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "",
                  "// The response is the async SyncResult. Counts land in Drive Sync History",
                  "// once the job finishes.",
                  "const b = pm.response.json();",
                  "console.log('sync response: ' + JSON.stringify(b));"
                ]
              }
            }
          ]
        },
