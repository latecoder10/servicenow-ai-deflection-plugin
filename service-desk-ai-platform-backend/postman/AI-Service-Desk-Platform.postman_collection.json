    {
      "name": "AI Deflection Engine",
      "item": [
        {
          "name": "Resolve Incident (AI Suggestion)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN keeps disconnecting every 30 minutes\",\n  \"description\": \"My GlobalProtect VPN connection drops every 30 minutes. SAML SSO authentication timeout error 50012.\",\n  \"callerEmail\": \"john.doe@enterprise.com\",\n  \"userDepartment\": \"Finance\",\n  \"category\": \"Network\",\n  \"minConfidenceThreshold\": 75,\n  \"includeDriveResults\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/suggestions/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "suggestions",
                "resolve"
              ]
            },
            "description": "userDepartment and category are applied as metadata filters at query time. If the filter matches nothing the search is retried unfiltered, so a narrow category never produces an empty panel.\n\nminConfidenceThreshold is an integer 0-100, not a decimal.\n\nincludeDriveResults mirrors the sidebar toggle. Set it to false to exclude documents synced from Google Drive; the search then returns fewer results rather than substituting weaker ones."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "",
                  "pm.test('has a resolution', () => {",
                  "    pm.expect(b.summaryResolution).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('steps are real, not the truncation placeholder', () => {",
                  "    pm.expect(b.stepByStepInstructions).to.be.an('array').that.is.not.empty;",
                  "    const first = b.stepByStepInstructions[0];",
                  "    pm.expect(first, 'LLM response was truncated - check finishReason=MAX_TOKENS')",
                  "        .to.not.include('Review the provided knowledge base context');",
                  "});",
                  "",
                  "pm.test('answer is attributed to its sources', () => {",
                  "    pm.expect(b.sources, 'sources missing from the response').to.be.an('array');",
                  "    if (b.sourcesCount > 0) {",
                  "        pm.expect(b.sources.length, 'sourcesCount > 0 but nothing cited').to.be.above(0);",
                  "    }",
                  "});",
                  "",
                  "pm.test('citations carry a followable link', () => {",
                  "    b.sources.forEach(s => {",
                  "        pm.expect(s).to.have.property('recordType');",
                  "        if (s.url) { pm.expect(s.url).to.match(/^https?:\\/\\//); }",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve Incident (should cite a Drive article)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/suggestions/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "suggestions",
                "resolve"
              ]
            },
            "description": "Phrased to match the IT-002 knowledge article rather than a historical incident. Check the sources array for a GOOGLE_DRIVE_DOC entry.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot connect to VPN while working from home\",\n  \"description\": \"The client will not connect from my home wifi. It worked in the office yesterday.\",\n  \"callerEmail\": \"jane.doe@enterprise.com\",\n  \"userDepartment\": \"IT\",\n  \"category\": \"Network & Connectivity\",\n  \"minConfidenceThreshold\": 60,\n  \"includeDriveResults\": true\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('cites at least one source', () => {",
                  "    pm.expect(pm.response.json().sources).to.be.an('array');",
                  "});",
                  "",
                  "const drive = pm.response.json().sources.filter(s => s.recordType === 'GOOGLE_DRIVE_DOC');",
                  "console.log('Drive-sourced citations: ' + drive.length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Record Feedback (This solved it)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/suggestions/{{suggestionId}}/feedback?outcome=SOLVED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "suggestions",
                "{{suggestionId}}",
                "feedback"
              ],
              "query": [
                {
                  "key": "outcome",
                  "value": "SOLVED"
                }
              ]
            },
            "description": "Records what the agent decided. Only SOLVED and CONTINUED are accepted; anything else is rejected so the deflection rate cannot be quietly corrupted.\n\nSet the suggestionId variable from a resolve response first."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 404 here means the suggestion id was never recorded, which is itself a finding.",
                  "pm.test('recorded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Generates a resolution for a ticket being typed.\n\nThe response carries a `sources` array citing the records the answer drew on, each with a record number, type and a deep link into ServiceNow or Drive."
    },
